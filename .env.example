# Copy this file to .env and add your own Gemini API key locally.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Passwords for the seeded demo accounts. Set your own before the database is first created.
# Left unset, a local run uses built-in development defaults and logs a warning; a hosted service
# (RENDER set, or SITESIGNAL_ENV=production) refuses to start without the manager and technician ones.
DEMO_MANAGER_PASSWORD=
DEMO_TECHNICIAN_PASSWORD=
DEMO_SALES_PASSWORD=

# Local paths (the app creates these folders automatically)
DATABASE_PATH=data/sitesignal.db
CHROMA_PATH=data/chroma
POLICY_PATH=data/policies
